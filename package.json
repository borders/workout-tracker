{
  "name": "workout-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "node scripts/smoke.cjs",
    "test:logging": "node scripts/logging-smoke.cjs",
    "build:hosted": "tsc --noEmit && vite build --base=/workouts/ && node scripts/build-server.mjs",
    "deploy:dreamhost": "npm run build:hosted && bash scripts/deploy-dreamhost.sh",
    "setup:sync": "bash scripts/setup-sync.sh",
    "test:sync-browser": "node scripts/sync-smoke.cjs",
    "test:progress": "node scripts/progress-smoke.cjs"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.2.6",
    "playwright": "^1.64.1",
    "typescript": "~5.8.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
